# DXMT VectorDB - 生产环境配置

# 服务器配置 - 生产环境绑定到所有接口
DB_HOST=0.0.0.0
DB_PORT=8080
DB_WORKER_THREADS=8

# 存储配置 - 生产环境使用分层存储
DB_STORAGE_TYPE=tiered
DB_MEMORY_CACHE_SIZE=2048
DB_SSD_CACHE_DIR=/var/lib/dxmt/cache
DB_SSD_CACHE_SIZE=100
DB_COMPRESSION=zstd

# 对象存储配置 - 生产环境使用AWS S3
DB_OBJECT_STORAGE_PROVIDER=s3
DB_S3_BUCKET=dxmt-prod-vectordb
DB_S3_REGION=us-west-2
# 生产环境建议使用IAM角色，不在配置文件中设置密钥
# DB_AWS_ACCESS_KEY_ID=使用IAM角色
# DB_AWS_SECRET_ACCESS_KEY=使用IAM角色

# 向量表配置 - 生产环境使用完整配置
DB_DEFAULT_DIMENSION=1536
DB_DEFAULT_DISTANCE_METRIC=cosine
DB_MAX_RECORDS_PER_TABLE=10000000

# 性能配置
DB_MAX_CONNECTIONS=5000
DB_QUERY_TIMEOUT=60

# 日志配置 - 生产环境使用结构化日志
DB_LOG_LEVEL=info
DB_LOG_FORMAT=json
