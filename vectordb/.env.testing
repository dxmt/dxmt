# DXMT VectorDB - 测试环境配置

# 服务器配置 - 测试环境使用随机端口
DB_HOST=127.0.0.1
DB_PORT=0
DB_WORKER_THREADS=1

# 存储配置 - 测试环境使用纯内存存储
DB_STORAGE_TYPE=memory
DB_MEMORY_CACHE_SIZE=128
DB_SSD_CACHE_DIR=/tmp/dxmt-test-cache
DB_SSD_CACHE_SIZE=1
DB_COMPRESSION=none

# 对象存储配置 - 测试环境使用本地存储模拟
DB_OBJECT_STORAGE_PROVIDER=local
DB_S3_BUCKET=test-bucket
DB_S3_REGION=us-east-1

# 向量表配置 - 测试环境使用小数据集
DB_DEFAULT_DIMENSION=128
DB_DEFAULT_DISTANCE_METRIC=euclidean
DB_MAX_RECORDS_PER_TABLE=1000

# 性能配置 - 测试环境使用宽松的限制
DB_MAX_CONNECTIONS=10
DB_QUERY_TIMEOUT=5

# 日志配置 - 测试环境详细日志
DB_LOG_LEVEL=trace
DB_LOG_FORMAT=compact
