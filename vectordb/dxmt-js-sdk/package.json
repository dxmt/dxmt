{
  "name": "dxmt-js-sdk",
  "version": "1.0.0",
  "description": "Official JavaScript/TypeScript SDK for DXMT VectorDB - A lightweight, horizontally scalable vector database",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./langchain": {
      "import": "./dist/langchain/index.mjs",
      "require": "./dist/langchain/index.js",
      "types": "./dist/langchain/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/langchain/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts src/langchain/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "vector-database",
    "vector-search",
    "embeddings",
    "similarity-search",
    "dxmt",
    "vectordb",
    "ai",
    "machine-learning",
    "langchain",
    "rag"
  ],
  "author": "DXMT Team",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/dxmt"
  },
  "bugs": {
    "url": "https://github.com/your-org/dxmt/issues"
  },
  "homepage": "https://github.com/your-org/dxmt#readme",
  "dependencies": {
    "cross-fetch": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitest/coverage-v8": "^1.2.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
