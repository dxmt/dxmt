{
  "name": "dxmt-js-sdk",
  "version": "1.6.0",
  "description": "JavaScript/TypeScript SDK for DXMT, the open-source memory database for personal agents",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./langchain": {
      "types": "./dist/langchain/index.d.ts",
      "import": "./dist/langchain/index.mjs",
      "require": "./dist/langchain/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LANGCHAIN.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/langchain/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts src/langchain/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "vector-database",
    "vector-search",
    "embeddings",
    "similarity-search",
    "dxmt",
    "vectordb",
    "ai",
    "machine-learning",
    "langchain",
    "rag"
  ],
  "author": "DXMT Team <contact@dxmt.online>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dxmt/dxmt.git",
    "directory": "vectordb/clients/dxmt-js-sdk"
  },
  "bugs": {
    "url": "https://github.com/dxmt/dxmt/issues"
  },
  "homepage": "https://github.com/dxmt/dxmt#readme",
  "dependencies": {
    "cross-fetch": "^4.0.0"
  },
  "devDependencies": {
    "@langchain/core": "^1.2.9",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "tsup": "^9.0.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
