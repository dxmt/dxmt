# DXMT VectorDB 环境配置文件
# 复制此文件为 .env 并根据需要修改配置

# ====================================
# 服务器网络配置
# ====================================

# 服务器绑定的IP地址
# 默认值: 0.0.0.0 (绑定到所有网络接口)
# 生产环境建议使用具体的内网IP地址
DB_HOST=0.0.0.0

# 服务器监听的端口号
# 默认值: 9999
# 有效范围: 1-65535
DB_PORT=9999

# ====================================
# 存储配置
# ====================================

# 存储类型: memory, indexed, object, tiered
DB_STORAGE_TYPE=tiered

# 内存缓存大小 (MB)
DB_MEMORY_CACHE_SIZE=512

# 目录布局。默认全部挂在一个根下面，这里一律注释掉：取消注释就是覆盖默认值。
# 之所以写成注释而不是赋值，是因为 `./cache` 这种相对路径跟着工作目录走——
# 换个目录启动就换了一份数据，这正是默认根从 `./data` 挪到 `~/.dxmt` 的原因。
#
# DB_ROOT_DIR=~/.dxmt                  # 根目录，其余各项默认都挂在它下面
# DB_WAL_DIR=$DB_ROOT_DIR/store        # WAL、快照、行文件——这个目录就是数据库本身
# DB_BACKUP_ROOT=$DB_ROOT_DIR/backups  # POST /backup 唯一允许写入的位置
# DB_CACHE_DIR=$DB_ROOT_DIR/cache      # 可重建，停机时删掉是安全的
# DB_SSD_CACHE_DIR=$DB_CACHE_DIR/ssd   # SSD 层
#
# 只设 DB_WAL_DIR 会把备份一起带走（备份该放在它所备份的数据旁边）；
# 显式设了 DB_ROOT_DIR 就以它为准，备份留在根下面。
# DB_WAL_DIR= （设了但为空）表示彻底关掉持久化：全内存，重启即丢。

# SSD缓存大小 (GB)
DB_SSD_CACHE_SIZE=10

# 压缩算法: zstd, lz4, none
DB_COMPRESSION=zstd

# ====================================
# 索引优化配置
# ====================================

# 内存优化开关（全局默认配置）
# true (默认): 启用内存优化，使用 Phase 4 Hybrid 索引
#              节省 85-90% 内存，召回率 87-95%
# false: 禁用优化，使用 HNSW/Phase 3 索引
#        保持高精度，召回率 95-99%
# 注意：每个表可以在创建时覆盖此全局配置
DB_MEMORY_OPTIMIZATION=true
# Where a new table keeps its records and full vectors: disk (row files under the WAL
# directory; the default) or memory. A table keeps the store it was created with.
DB_RECORD_STORE=disk
DB_VECTOR_STORE=disk
# Half-precision vector rows for new tables (2 bytes per dimension). Off by default.
DB_VECTOR_F16=0

# ====================================
# 对象存储配置
# ====================================

# 对象存储提供商: s3, minio, local
DB_OBJECT_STORAGE_PROVIDER=s3

# S3桶名称
DB_S3_BUCKET=dxmt-vectordb

# S3区域
DB_S3_REGION=us-east-1

# S3端点 (可选，用于MinIO等兼容服务)
# DB_S3_ENDPOINT=http://localhost:9000

# AWS访问密钥 (可选，建议使用IAM角色)
# DB_AWS_ACCESS_KEY_ID=your_access_key
# DB_AWS_SECRET_ACCESS_KEY=your_secret_key

# ====================================
# 向量表默认配置
# ====================================

# 默认向量维度
DB_DEFAULT_DIMENSION=1536

# 默认距离度量: cosine, euclidean, dot_product
DB_DEFAULT_DISTANCE_METRIC=cosine

# 每个表的最大记录数
DB_MAX_RECORDS_PER_TABLE=1000000

# ====================================
# 集群配置
# ====================================

# 集群节点ID
# DB_NODE_ID=node-1

# Consul地址 (用于服务发现)
# DB_CONSUL_ADDRESS=http://localhost:8500

# 集群名称
# DB_CLUSTER_NAME=dxmt-vectordb-cluster

# ====================================
# 日志配置
# ====================================

# 日志级别: trace, debug, info, warn, error
DB_LOG_LEVEL=info

# 日志格式: pretty, json, compact
DB_LOG_FORMAT=pretty

# ====================================
# 性能配置
# ====================================

# 工作线程数 (留空表示使用CPU核数)
# DB_WORKER_THREADS=4

# 最大并发连接数
# DB_MAX_CONNECTIONS=1000

# 查询超时时间 (秒)
# DB_QUERY_TIMEOUT=30

# ====================================
# GPU 加速配置
# ====================================
# 需要编译时启用 gpu feature: cargo build --features gpu
# 运行时自动检测 GPU 硬件，无 GPU 则静默回退到 CPU+SIMD

# GPU 设备 ID (0-indexed, 多 GPU 时选择使用哪个)
# DB_GPU_DEVICE_ID=0

# GPU 显存使用比例 (0.0-1.0)
# DB_GPU_MEMORY_FRACTION=0.8

# 最少向量数才启用 GPU (低于此数量 CPU+SIMD 更快)
# DB_GPU_BATCH_THRESHOLD=1000

# 单批次最大向量数 (受 GPU 显存限制)
# DB_GPU_MAX_BATCH_SIZE=500000
