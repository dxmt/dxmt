# DXMT VectorDB 环境配置文件
# 复制此文件为 .env 并根据需要修改配置

# ====================================
# 服务器网络配置
# ====================================

# 服务器绑定的IP地址
# 默认值: 0.0.0.0 (绑定到所有网络接口)
# 生产环境建议使用具体的内网IP地址
DXMT_HOST=0.0.0.0

# 服务器监听的端口号
# 默认值: 9999
# 有效范围: 1-65535
DXMT_PORT=9999

# ====================================
# 存储配置
# ====================================

# 内存缓存大小 (MB)
DXMT_MEMORY_CACHE_SIZE=512

# API 密钥。不设或为空 = 不启用鉴权（与 Qdrant / Chroma / Weaviate 的默认一致）。
# 设了之后除 /health、/live、/ready 外一律要求 `api-key` 头或 `Authorization: Bearer`。
# 一把静态密钥，没有轮换、没有账号——它挡的是"端口活得比防火墙规则久"，不是替代 TLS。
# DXMT_API_KEY=

# 目录布局。默认全部挂在一个根下面，这里一律注释掉：取消注释就是覆盖默认值。
# 之所以写成注释而不是赋值，是因为 `./cache` 这种相对路径跟着工作目录走——
# 换个目录启动就换了一份数据，这正是默认根从 `./data` 挪到 `~/.dxmt` 的原因。
#
# DXMT_ROOT_DIR=~/.dxmt                  # 根目录，其余各项默认都挂在它下面
# DXMT_WAL_DIR=$DXMT_ROOT_DIR/store        # WAL、快照、行文件——这个目录就是数据库本身
# DXMT_BACKUP_ROOT=$DXMT_ROOT_DIR/backups  # POST /backup 唯一允许写入的位置
# DXMT_CACHE_DIR=$DXMT_ROOT_DIR/cache      # 可重建，停机时删掉是安全的
# DXMT_SSD_CACHE_DIR=$DXMT_CACHE_DIR/ssd   # SSD 层
#
# 只设 DXMT_WAL_DIR 会把备份一起带走（备份该放在它所备份的数据旁边）；
# 显式设了 DXMT_ROOT_DIR 就以它为准，备份留在根下面。
# DXMT_WAL_DIR= （设了但为空）表示彻底关掉持久化：全内存，重启即丢。

# SSD缓存大小 (GB)
DXMT_SSD_CACHE_SIZE=10

# 压缩算法: zstd, lz4, none
DXMT_COMPRESSION=zstd

# ====================================
# 索引优化配置
# ====================================

# 内存优化开关（全局默认配置）
# true (默认): 启用内存优化，使用 Phase 4 Hybrid 索引
#              节省 85-90% 内存，召回率 87-95%
# false: 禁用优化，使用 HNSW/Phase 3 索引
#        保持高精度，召回率 95-99%
# 注意：每个表可以在创建时覆盖此全局配置
DXMT_MEMORY_OPTIMIZATION=true
# Where a new table keeps its records and full vectors: disk (row files under the WAL
# directory; the default) or memory. A table keeps the store it was created with.
DXMT_RECORD_STORE=disk
DXMT_VECTOR_STORE=disk
# Half-precision vector rows for new tables (2 bytes per dimension). Off by default.
DXMT_VECTOR_F16=0

# ====================================
# 对象存储配置
# ====================================

# 对象存储提供商: s3, minio, local
DXMT_OBJECT_STORAGE_PROVIDER=s3

# S3桶名称
DXMT_S3_BUCKET=dxmt-vectordb

# S3区域
DXMT_S3_REGION=us-east-1

# S3端点 (可选，用于MinIO等兼容服务)
# DXMT_S3_ENDPOINT=http://localhost:9000

# AWS访问密钥 (可选，建议使用IAM角色)
# DXMT_AWS_ACCESS_KEY_ID=your_access_key
# DXMT_AWS_SECRET_ACCESS_KEY=your_secret_key

# ====================================
# 向量表默认配置
# ====================================

# 默认向量维度
DXMT_DEFAULT_DIMENSION=1536

# 默认距离度量: cosine, euclidean, dot_product
DXMT_DEFAULT_DISTANCE_METRIC=cosine

# 每个表的最大记录数
DXMT_MAX_RECORDS_PER_TABLE=1000000

# 日志配置
# ====================================

# 日志级别: trace, debug, info, warn, error
DXMT_LOG_LEVEL=info

# 日志格式: pretty, json, compact
DXMT_LOG_FORMAT=pretty

# ====================================
# 性能配置
# ====================================

# 工作线程数 (留空表示使用CPU核数)
# DXMT_WORKER_THREADS=4

# 最大并发连接数
# DXMT_MAX_CONNECTIONS=1000

# 查询超时时间 (秒)
# DXMT_QUERY_TIMEOUT=30
