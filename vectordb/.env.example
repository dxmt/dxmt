# DXMT VectorDB -- copy to `.env` and uncomment what you want to change.
#
# `vectordb serve` reads `.env` from the directory it starts in. A variable already set in the
# environment wins over this file, and a command-line flag wins over both. Every line here is
# a variable the server reads; the README's Configuration section has the rest.

# ── network ──────────────────────────────────────────────────────────────────
# DXMT_HOST=127.0.0.1      # same as --host; the default. 0.0.0.0 serves the network --
                           # set DXMT_API_KEY first, or every route is open to it
# DXMT_PORT=9999           # same as --port
# DXMT_GRPC_PORT=0         # same as --grpc-port; 0 is off (needs the api-grpc build)
# DXMT_WORKER_THREADS=4    # request worker threads; unset is one per CPU core

# ── authentication ───────────────────────────────────────────────────────────
# Unset or empty: no authentication, as with Qdrant, Chroma and Weaviate. Set: every route
# except /health, /live and /ready needs an `api-key` header or `Authorization: Bearer`.
# One static key, no rotation and no accounts -- put TLS in front of it.
# DXMT_API_KEY=

# ── where the data lives ─────────────────────────────────────────────────────
# Everything defaults to one root. Relative paths follow the working directory, which is why
# the default root is ~/.dxmt rather than ./data.
# DXMT_ROOT_DIR=~/.dxmt                   # the root the others default under
# DXMT_WAL_DIR=$DXMT_ROOT_DIR/store       # WAL, snapshots, row files: this is the database
# DXMT_BACKUP_ROOT=$DXMT_ROOT_DIR/backups # the only place POST /backup may write
# DXMT_CACHE_DIR=$DXMT_ROOT_DIR/cache     # rebuildable; safe to delete while stopped
# DXMT_SSD_CACHE_DIR=$DXMT_CACHE_DIR/ssd  # the SSD tier
#
# Setting only DXMT_WAL_DIR moves the backups with it; an explicit DXMT_ROOT_DIR keeps them
# under the root. DXMT_WAL_DIR= (set and empty) turns persistence off: memory only, gone on
# restart.

# ── storage ──────────────────────────────────────────────────────────────────
# DXMT_RECORD_STORE=disk         # disk (row files under the WAL directory) or memory
# DXMT_VECTOR_STORE=disk         # a table keeps the stores it was created with
# DXMT_VECTOR_F16=0              # 1 keeps new tables' full vectors as fp16
# DXMT_MEMORY_CACHE_SIZE=512     # MB
# DXMT_SSD_CACHE_SIZE=10         # GB
# DXMT_MIN_FREE_MEMORY_MB=1024   # refuse writes below this much free memory; 0 is off,
                                 # unset is 5% of total memory

# ── background work (seconds; 0 disables) ────────────────────────────────────
# DXMT_SNAPSHOT_INTERVAL_SECS=300
# ── text without vectors ─────────────────────────────────────────────────────
# The model a table created with neither a dimension nor a model uses, and the one the notes
# table below is made with. Unset, the server looks for a local ollama and takes an embedding
# model it already has, preferring a multilingual one (`ollama pull bge-m3`).
# DXMT_EMBEDDING_MODEL=text-embedding-3-small
# DXMT_EMBEDDING_BASE_URL=https://api.openai.com/v1
# DXMT_EMBEDDING_API_KEY_ENV=OPENAI_API_KEY
# DXMT_EMBEDDING_AUTODETECT=1            # 0: do not look for a local ollama
# DXMT_EMBEDDING_TIMEOUT_SECS=60         # one embedding or rerank call; a batch that runs past it
                                        # is split in half until it fits, and the size that fit
                                        # is kept for that model. Raise it for a slow local model
# DXMT_KB_TABLE=kb                       # made on its first write; `off` disables it

# DXMT_BACKUP_INTERVAL_SECS=0            # scheduled backups into DXMT_BACKUP_ROOT/auto-<time>; off by
                                         # default, each one is a full copy of the store
# DXMT_BACKUP_KEEP=7                     # scheduled backups kept; hand-taken ones are never pruned
# DXMT_EVICTION_INTERVAL_SECS=600        # drop cold tables from memory
# DXMT_REINDEX_INTERVAL_SECS=900         # re-check the index choice against table size
# DXMT_ROW_COMPACTION_INTERVAL_SECS=600  # release the disk behind dead row-file rows
# DXMT_PARTITION_THRESHOLD_MB=512        # vector bytes above which a table partitions

# ── indexing ─────────────────────────────────────────────────────────────────
# DXMT_MEMORY_OPTIMIZATION=true    # the index-selection path; see the README's Architecture
# DXMT_INDEX_ALGORITHM=hnsw-pq     # hnsw-pq or hnsw, for new tables
# DXMT_RECALL_TARGET=0.95          # the recall a table calibrates its search budget to

# ── object storage (opt-in, best-effort mirroring) ───────────────────────────
# Credentials come from the environment only; never commit them.
# DXMT_OBJECT_STORAGE_PROVIDER=s3
# DXMT_S3_BUCKET=
# DXMT_S3_REGION=us-east-1
# DXMT_S3_ENDPOINT=http://localhost:9000   # for MinIO and other S3-compatible services
# DXMT_AWS_ACCESS_KEY_ID=
# DXMT_AWS_SECRET_ACCESS_KEY=
