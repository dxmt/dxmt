FROM rust:latest

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    clang \
    libclang-dev \
    libzstd-dev \
    librocksdb-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Copy source code
COPY . .

# Build the project
RUN cargo build --release

CMD ["cargo", "test"]
