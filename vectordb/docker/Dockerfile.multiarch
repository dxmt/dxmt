# =============================================================================
# DXMT VectorDB - multi-architecture Docker image
# Platforms: linux/amd64, linux/arm64 (cross-compiled on the build platform)
# Build context: the `vectordb/` directory, e.g.
#   docker buildx build -f docker/Dockerfile.multiarch --platform linux/amd64,linux/arm64 \
#     -t dxmt/vectordb:latest .
# =============================================================================

# Builder and runtime on the same Debian release, so the binary's glibc is the runtime's.
ARG RUST_VERSION=1
ARG DEBIAN_VERSION=bookworm

# -----------------------------------------------------------------------------
# The web console's bundle; platform-independent, so built on the build platform.
# -----------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM node:22-${DEBIAN_VERSION}-slim AS dashboard-builder

WORKDIR /dashboard
COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci
COPY dashboard/ ./
RUN npm run build

# -----------------------------------------------------------------------------
# Stage 1: build environment
# -----------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM rust:${RUST_VERSION}-${DEBIAN_VERSION} AS builder

# Build arguments
ARG TARGETPLATFORM
ARG BUILDPLATFORM
ARG TARGETOS
ARG TARGETARCH
ARG BUILD_DATE
ARG VCS_REF
ARG VERSION

# Print what is being built for
RUN echo "Building for: $TARGETPLATFORM" && \
    echo "Building on: $BUILDPLATFORM" && \
    echo "Target arch: $TARGETARCH"

# Build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    cmake \
    git \
    curl \
    gcc \
    g++ \
    clang \
    libclang-dev \
    llvm-dev \
    libssl-dev \
    libzstd-dev \
    zstd \
    liblz4-dev \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# Cross-compilation toolchain for the target architecture
RUN if [ "$TARGETARCH" = "arm64" ]; then \
        apt-get update && \
        apt-get install -y gcc-aarch64-linux-gnu g++-aarch64-linux-gnu && \
        rustup target add aarch64-unknown-linux-gnu && \
        rm -rf /var/lib/apt/lists/*; \
    fi

# Cargo settings
ENV CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse \
    CARGO_NET_GIT_FETCH_WITH_CLI=true \
    RUST_BACKTRACE=1

# Working directory
WORKDIR /build

# The whole crate, not placeholders: the placeholder stage stubbed two of the five `[[bin]]`
# targets and none of the `[[test]]` or `[[example]]` ones, so cargo refused the manifest.
COPY Cargo.toml Cargo.lock build.rs ./
COPY src ./src
COPY benches ./benches
COPY tests ./tests
COPY examples ./examples
COPY proto ./proto
COPY --from=dashboard-builder /dashboard/dist ./dashboard/dist

# Build for the target architecture
RUN if [ "$TARGETARCH" = "arm64" ]; then \
        export CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc && \
        export CXX_aarch64_unknown_linux_gnu=aarch64-linux-gnu-g++ && \
        export CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc && \
        cargo build --release --bin vectordb --target aarch64-unknown-linux-gnu && \
        strip target/aarch64-unknown-linux-gnu/release/vectordb && \
        cp target/aarch64-unknown-linux-gnu/release/vectordb /build/vectordb; \
    else \
        cargo build --release --bin vectordb && \
        strip target/release/vectordb && \
        cp target/release/vectordb /build/vectordb; \
    fi

# Check the binary
RUN file /build/vectordb && \
    ls -lh /build/vectordb

# -----------------------------------------------------------------------------
# Stage 2: runtime image
# -----------------------------------------------------------------------------
# The same Debian release as the build stage, so the binary's glibc matches
FROM --platform=$TARGETPLATFORM debian:${DEBIAN_VERSION}-slim AS runtime

# Labels
ARG BUILD_DATE
ARG VCS_REF
ARG VERSION

# OCI labels
LABEL org.opencontainers.image.title="DXMT VectorDB" \
      org.opencontainers.image.description="Lightweight single-node vector database for AI applications" \
      org.opencontainers.image.authors="DXMT Team" \
      org.opencontainers.image.vendor="DXMT" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.url="https://github.com/dxmt/dxmt" \
      org.opencontainers.image.source="https://github.com/dxmt/dxmt" \
      org.opencontainers.image.documentation="https://docs.dxmt.online" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.version="${VERSION}"

# Runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    libzstd1 \
    liblz4-1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Non-root user
RUN groupadd -r vectordb && \
    useradd -r -g vectordb -s /bin/false vectordb && \
    mkdir -p /data /config /logs && \
    chown -R vectordb:vectordb /data /config /logs

# The binary
COPY --from=builder --chown=vectordb:vectordb /build/vectordb /usr/local/bin/vectordb

# Default configuration
COPY --chown=vectordb:vectordb config /config

# Switch to the non-root user
USER vectordb

# Port
EXPOSE 9999

# Health check: /ready answers 503 while durability is degraded
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -fsS http://localhost:${PORT}/ready || exit 1

# Volumes
VOLUME ["/data", "/config", "/logs"]

# Working directory
WORKDIR /data

# Environment. `DXMT_ROOT_DIR` is the variable the server reads; the store goes to /data/store
# and backups to /data/backups.
ENV DXMT_ROOT_DIR=/data \
    RUST_LOG=info \
    PORT=9999

# Give the process a chance to flush its WAL and snapshot before the container is killed.
STOPSIGNAL SIGTERM

# Start command. `--host 0.0.0.0` is needed inside a container; set DXMT_API_KEY before
# publishing the port anywhere you do not control.
ENTRYPOINT ["/usr/local/bin/vectordb"]
CMD ["serve", "--host", "0.0.0.0", "--port", "9999"]
