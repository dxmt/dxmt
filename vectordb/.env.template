# DXMT VectorDB Configuration Template
# Copy this file to .env and modify values as needed

# Server Configuration
VECTORDB_HOST=0.0.0.0
VECTORDB_PORT=9999
VECTORDB_DATA_DIR=./data

# Feature Toggles (default: disabled for minimal surface)
VECTORDB_ENABLE_SWAGGER=false
VECTORDB_ENABLE_GRAPHQL=false
VECTORDB_ENABLE_WEBSOCKET=false
VECTORDB_ENABLE_CLUSTER=false

# Authentication & Security
VECTORDB_AUTH_ENABLED=false
VECTORDB_JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
VECTORDB_API_KEY=your-api-key-here
VECTORDB_CORS_ORIGINS=*

# Database Configuration
VECTORDB_STORAGE_ENGINE=hybrid  # hybrid, lmdb, rocksdb
VECTORDB_WAL_ENABLED=true
VECTORDB_WAL_SYNC_MODE=fsync    # fsync, normal, off

# Index Configuration
VECTORDB_DEFAULT_INDEX_TYPE=hnsw  # hnsw, ivf_pq, flat
VECTORDB_HNSW_M=16
VECTORDB_HNSW_EF_CONSTRUCTION=200
VECTORDB_IVF_PQ_LISTS=1024
VECTORDB_IVF_PQ_SUBQUANTIZERS=8

# Search Configuration
VECTORDB_DEFAULT_FUSION_METHOD=optimized_rrf  # weighted_sum, rrf, optimized_rrf
VECTORDB_HYBRID_TEXT_WEIGHT=0.4
VECTORDB_HYBRID_VECTOR_WEIGHT=0.6

# Performance Tuning
VECTORDB_WORKER_THREADS=4
VECTORDB_MAX_CONNECTIONS=1000
VECTORDB_QUERY_TIMEOUT_SECS=30
VECTORDB_BATCH_SIZE=1000

# Observability
VECTORDB_LOG_LEVEL=info
VECTORDB_METRICS_ENABLED=true
VECTORDB_METRICS_PORT=9090
VECTORDB_TRACING_ENABLED=false
VECTORDB_TRACING_ENDPOINT=http://localhost:14268/api/traces

# Cluster Configuration (when VECTORDB_ENABLE_CLUSTER=true)
VECTORDB_NODE_ID=node-1
VECTORDB_CLUSTER_NODES=node-1:9999,node-2:9999,node-3:9999
VECTORDB_REPLICATION_FACTOR=3
VECTORDB_SHARD_COUNT=256
VECTORDB_ELECTION_TIMEOUT_MS=5000
VECTORDB_HEARTBEAT_INTERVAL_MS=1000

# Storage Engine Specific
# Hybrid Engine
VECTORDB_WRITE_BUFFER_SIZE_MB=256
VECTORDB_FLUSH_INTERVAL_SECS=30
VECTORDB_MIGRATION_INTERVAL_SECS=300
VECTORDB_COLD_THRESHOLD_HOURS=24

# LMDB Configuration
VECTORDB_LMDB_MAP_SIZE_GB=10
VECTORDB_LMDB_MAX_DBS=128

# RocksDB Configuration
VECTORDB_ROCKSDB_BLOCK_CACHE_SIZE_MB=512
VECTORDB_ROCKSDB_WRITE_BUFFER_SIZE_MB=64
VECTORDB_ROCKSDB_MAX_WRITE_BUFFER_NUMBER=3
VECTORDB_ROCKSDB_COMPRESSION=lz4

# Development/Testing
VECTORDB_DEV_MODE=false
VECTORDB_BENCHMARK_ON_STARTUP=false
VECTORDB_MOCK_SLOW_QUERIES=false
