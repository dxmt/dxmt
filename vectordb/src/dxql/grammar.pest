// DXQL Grammar - DXMT Query Language
// SQL-like syntax for vector, text, and graph queries

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ "--" ~ (!"\n" ~ ANY)* }

// Main query rule
query = { SOI ~ statement ~ EOI }

statement = {
    select_statement
    | insert_statement
    | update_statement
    | delete_statement
    | create_statement
    | drop_statement
}

// SELECT statement
select_statement = {
    "SELECT" ~ select_list ~
    "FROM" ~ table_name ~
    where_clause? ~
    order_by_clause? ~
    limit_clause?
}

select_list = {
    "*" | (select_item ~ ("," ~ select_item)*)
}

select_item = {
    field_name ~ ("AS" ~ alias)?
}

// WHERE clause with vector and text search
where_clause = {
    "WHERE" ~ condition
}

condition = {
    and_condition
}

and_condition = {
    or_condition ~ ("AND" ~ or_condition)*
}

or_condition = {
    primary_condition ~ ("OR" ~ primary_condition)*
}

primary_condition = {
    vector_similarity_condition
    | text_match_condition
    | graph_distance_condition
    | comparison_condition
    | in_condition
    | between_condition
    | "(" ~ condition ~ ")"
}

// Vector similarity search
vector_similarity_condition = {
    "vector_similarity" ~ "(" ~ field_name ~ "," ~ vector_value ~ ")" ~ comparison_op ~ number
}

// Text search
text_match_condition = {
    "text_match" ~ "(" ~ field_name ~ "," ~ string_literal ~ ")"
}

// Graph distance search
graph_distance_condition = {
    "graph_distance" ~ "(" ~ field_name ~ "," ~ string_literal ~ ")" ~ comparison_op ~ integer
}

// Standard comparison
comparison_condition = {
    field_name ~ comparison_op ~ value
}

in_condition = {
    field_name ~ "IN" ~ "(" ~ value_list ~ ")"
}

between_condition = {
    field_name ~ "BETWEEN" ~ value ~ "AND" ~ value
}

// ORDER BY clause with hybrid scoring
order_by_clause = {
    "ORDER" ~ "BY" ~ order_item ~ ("," ~ order_item)*
}

order_item = {
    hybrid_score_func | (field_name ~ order_direction?)
}

hybrid_score_func = {
    "hybrid_score" ~ "(" ~ number ~ "," ~ number ~ "," ~ number ~ ")"
}

order_direction = {
    "ASC" | "DESC"
}

// LIMIT clause
limit_clause = {
    "LIMIT" ~ integer ~ ("OFFSET" ~ integer)?
}

// INSERT statement
insert_statement = {
    "INSERT" ~ "INTO" ~ table_name ~
    "(" ~ field_list ~ ")" ~
    "VALUES" ~ "(" ~ value_list ~ ")"
}

// UPDATE statement
update_statement = {
    "UPDATE" ~ table_name ~
    "SET" ~ assignment_list ~
    where_clause?
}

assignment_list = {
    assignment ~ ("," ~ assignment)*
}

assignment = {
    field_name ~ "=" ~ value
}

// DELETE statement
delete_statement = {
    "DELETE" ~ "FROM" ~ table_name ~
    where_clause?
}

// CREATE statement
create_statement = {
    create_table_statement
    | create_index_statement
}

create_table_statement = {
    "CREATE" ~ "TABLE" ~ table_name ~ "(" ~
    column_definition ~ ("," ~ column_definition)* ~
    ")"
}

column_definition = {
    field_name ~ data_type ~ column_constraint*
}

data_type = {
    "VECTOR" ~ "(" ~ integer ~ ")"
    | "TEXT"
    | "INTEGER"
    | "FLOAT"
    | "BOOLEAN"
    | "JSON"
    | "TIMESTAMP"
}

column_constraint = {
    "PRIMARY" ~ "KEY"
    | "NOT" ~ "NULL"
    | "UNIQUE"
    | "DEFAULT" ~ value
}

create_index_statement = {
    "CREATE" ~ index_type? ~ "INDEX" ~ index_name ~
    "ON" ~ table_name ~ "(" ~ field_name ~ ")" ~
    index_options?
}

index_type = {
    "HNSW" | "IVF" | "FLAT" | "BM25" | "GRAPH"
}

index_options = {
    "WITH" ~ "(" ~ option_list ~ ")"
}

option_list = {
    option ~ ("," ~ option)*
}

option = {
    identifier ~ "=" ~ value
}

// DROP statement
drop_statement = {
    "DROP" ~ ("TABLE" | "INDEX") ~ identifier
}

// Values and literals
value = {
    vector_value
    | string_literal
    | number
    | boolean
    | null
    | parameter
}

vector_value = {
    "[" ~ number_list ~ "]"
    | parameter
}

number_list = {
    number ~ ("," ~ number)*
}

value_list = {
    value ~ ("," ~ value)*
}

field_list = {
    field_name ~ ("," ~ field_name)*
}

// Comparison operators
comparison_op = {
    "=" | "!=" | "<>" | "<" | "<=" | ">" | ">=" | "LIKE"
}

// Basic tokens
table_name = @{ identifier }
field_name = @{ identifier }
index_name = @{ identifier }
alias = @{ identifier }

identifier = @{
    (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")*
    | "`" ~ (!"`" ~ ANY)+ ~ "`"
}

string_literal = @{
    "'" ~ (!"'" ~ ANY | "''")* ~ "'"
    | "\"" ~ (!"\"" ~ ANY | "\"\"")* ~ "\""
}

number = @{
    "-"? ~ (integer | float)
}

integer = @{
    ASCII_DIGIT+
}

float = @{
    ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)?
}

boolean = {
    "TRUE" | "FALSE" | "true" | "false"
}

null = {
    "NULL" | "null"
}

parameter = @{
    "$" ~ (ASCII_ALPHANUMERIC | "_")+
    | "?" ~ ASCII_DIGIT*
}