# DXMT VectorDB - 开发环境配置

# 服务器配置
DB_HOST=127.0.0.1
DB_PORT=9999
DB_WORKER_THREADS=2

# 存储配置 - 开发环境使用内存存储
DB_STORAGE_TYPE=memory
DB_MEMORY_CACHE_SIZE=256
DB_SSD_CACHE_DIR=./dev-cache
DB_SSD_CACHE_SIZE=5
DB_COMPRESSION=lz4

# 对象存储配置 - 开发环境使用本地MinIO
DB_OBJECT_STORAGE_PROVIDER=minio
DB_S3_BUCKET=dxmt-dev-bucket
DB_S3_REGION=us-east-1
DB_S3_ENDPOINT=http://localhost:9000

# 向量表配置 - 开发环境使用较小的限制
DB_DEFAULT_DIMENSION=768
DB_DEFAULT_DISTANCE_METRIC=cosine
DB_MAX_RECORDS_PER_TABLE=100000

# 日志配置
DB_LOG_LEVEL=debug
DB_LOG_FORMAT=pretty
